{
  "name": "dodam",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/split-content.mjs",
    "predev": "node scripts/split-content.mjs",
    "prebuild:native": "node scripts/split-content.mjs",
    "pretypecheck": "node scripts/split-content.mjs",
    "dev": "next dev",
    "build": "next build",
    "build:native": "BUILD_TARGET=native next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa": "node scripts/qa/run.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "cap:sync": "npm run build:native && cap sync ios",
    "cap:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@vercel/kv": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "lighthouse": "^13.4.1",
    "shadcn": "^3.8.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "description": "Dodam — a month-by-month record of a baby's milestones, play ideas and safety notes."
}
